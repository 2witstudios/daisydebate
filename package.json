{
  "name": "daisy",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "happy-dom": "21.0.4"
  },
  "scripts": {
    "dev": "bun scripts/heavy.ts bun --env-file=.env run turbo run dev",
    "dev:agent": "bun scripts/heavy.ts bun scripts/dev-agent.ts",
    "dev:login": "bun --env-file=.env scripts/dev-login.ts",
    "demo": "bun --env-file=.env apps/web/e2e/support/demo.ts",
    "demo:link": "bun --env-file=.env apps/web/e2e/support/demo-link.ts",
    "build": "bun scripts/heavy.ts sh -c 'NODE_ENV=production turbo run build && bun run check:build-isolation'",
    "check:build-isolation": "bun scripts/check-build-artifact-isolation.ts",
    "start": "bun run --cwd apps/web start",
    "typecheck": "bun scripts/heavy.ts turbo run typecheck",
    "lint": "bun scripts/heavy.ts sh -c 'eslint . && bun scripts/check-boundaries.ts && bun scripts/check-styling.ts && bun test --timeout 180000 eslint.config.test.ts'",
    "knip": "bun scripts/heavy.ts bunx --bun knip",
    "duplication": "bun scripts/heavy.ts bun scripts/duplication.ts",
    "metrics": "bun scripts/metrics.ts",
    "metrics:snapshot": "bun scripts/metrics.ts --append",
    "metrics:check": "bun scripts/metrics.ts --check",
    "policy": "bun scripts/policy.ts",
    "adr:next": "bun scripts/number-claims.ts",
    "plan:review": "bun scripts/plan-review.ts",
    "github:rules": "bun scripts/github-rules.ts",
    "staging:security-probe": "bun scripts/staging-security-probe.ts",
    "invariants": "bun scripts/invariants.ts",
    "evidence": "bun scripts/evidence.ts",
    "migrations:check": "bun scripts/check-migrations.ts",
    "check:affected": "bun scripts/heavy.ts bun scripts/check-affected.ts",
    "hooks:install": "git config core.hooksPath .githooks",
    "board:read": "bun scripts/board.ts read",
    "board:hash": "bun scripts/board.ts hash",
    "board:status": "bun scripts/board.ts status",
    "board:create": "bun scripts/board.ts create",
    "board:relate": "bun scripts/board.ts relate",
    "board:replace": "bun scripts/board.ts replace",
    "board:stale": "bun scripts/board-stale.ts",
    "progress:sync": "bun scripts/progress-canvas.ts",
    "decision:record": "bun scripts/decision.ts",
    "docs:classify": "bun scripts/docs-pipeline.ts",
    "docs:dispatch": "bun scripts/dispatch-docs.ts",
    "docs:policy": "bun scripts/docs-policy.ts",
    "docs:prompt": "bun scripts/docs-prompt.ts",
    "docs:verify": "bun scripts/docs-verify.ts",
    "docs:location": "bun scripts/pagespace-docs.ts",
    "docs:reconcile": "bun scripts/docs-reconcile.ts",
    "doctor": "bun --env-file=.env scripts/doctor.ts",
    "auth:provision": "bun scripts/provision-auth-env.ts",
    "verify": "bun scripts/heavy.ts bun --env-file=.env scripts/verify.ts",
    "scenario": "bun scripts/scenario.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun scripts/heavy.ts sh -c 'bun test scripts && turbo run test'",
    "test:lint": "bun test --timeout 180000 eslint.config.test.ts",
    "test:integration": "bun scripts/heavy.ts bun --env-file=.env run turbo run test:integration --concurrency=1",
    "visual:server": "bun scripts/visual-server.ts",
    "test:e2e": "bun scripts/heavy.ts bun --env-file=.env run turbo run test:e2e",
    "test:e2e:qualify": "bun --env-file=.env scripts/e2e-release-qualification.ts",
    "check": "bun scripts/heavy.ts sh -c 'bun format:check && bun lint && bun run policy && bun run invariants && bun typecheck && bun run test && bun run build'",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun --env-file=.env packages/db/scripts/migrate.ts",
    "db:seed": "bun --env-file=.env scripts/seed.ts",
    "season": "bun --env-file=.env scripts/season.ts",
    "db:studio": "bun --env-file=.env run --cwd packages/db db:studio",
    "db:reset": "bun --env-file=.env scripts/db-reset.ts",
    "db:roles": "bun scripts/db-roles.ts",
    "restore:invalidate": "bun scripts/post-restore-invalidate.ts",
    "restore:seed": "bun scripts/staging-restore-seed.ts",
    "proof:test-redis": "bun scripts/prove-test-redis.ts",
    "proof:test-postgres": "bun --env-file=.env scripts/prove-test-postgres.ts && bun --env-file=.env scripts/prove-test-postgres-orphan.ts",
    "slot:up": "bun scripts/slot.ts up",
    "slot:down": "bun scripts/slot.ts down",
    "slot:reset-e2e": "bun scripts/slot.ts reset-e2e",
    "slot:prune": "bun scripts/slot.ts prune",
    "infra:logs": "docker compose -f infra/compose.yaml logs -f",
    "audit": "bun scripts/audit.ts",
    "test:e2e:room-launch": "bun --env-file=.env apps/web/e2e/support/room-launch-runner.ts",
    "test:e2e:realtime": "bun --env-file=.env apps/web/e2e/support/realtime-runner.ts room",
    "test:e2e:messaging-realtime": "bun --env-file=.env apps/web/e2e/support/realtime-runner.ts messaging",
    "proof:round-judging": "bun scripts/heavy.ts bun scripts/prove-round-judging.ts",
    "proof:media-worker": "bun scripts/heavy.ts bun scripts/prove-media-worker.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/bun": "1.4.2",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "jscpd": "5.3.0",
    "knip": "6.37.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "riteway": "9.3.0",
    "tailwindcss": "4.3.3",
    "turbo": "2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "dependencies": {
    "@daisy/ai-voice": "workspace:*",
    "@daisy/auth": "workspace:*",
    "@daisy/clock": "workspace:*",
    "@daisy/config": "workspace:*",
    "@daisy/db": "workspace:*",
    "@daisy/debate-engine": "workspace:*",
    "@daisy/errors": "workspace:*",
    "@daisy/logger": "workspace:*",
    "@daisy/media": "workspace:*",
    "@daisy/protocol": "workspace:*",
    "@daisy/redis": "workspace:*"
  }
}
