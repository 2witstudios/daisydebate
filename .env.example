NODE_ENV=development
# One shared local stack (infra/compose.yaml): Postgres on host port 15432,
# Redis on 6379. `bun slot:up` owns the slot values below: in the main
# checkout they are these defaults; in a git worktree it rewrites the
# database names, Redis namespaces and ports to that worktree's own slot
# (ADR 0034). Keep host, port and credentials; never hand-edit slot names.
DATABASE_URL=postgres://daisy:local-development-only@localhost:15432/daisy
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=daisy
PORT=3000
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
APP_VERSION=development
GIT_COMMIT=unknown
TEST_DATABASE_URL=postgres://daisy:local-development-only@localhost:15432/daisy_test
TEST_REDIS_URL=redis://localhost:6379/1
# Browser suite: the production server runs as the loopback-only daisy_e2e
# role against this slot's test database, in its own Redis database and
# namespace. E2E_PORT and the next two ports are the app, TLS edge and mail
# capture; a pinned port also disables reuse of a running server.
E2E_PORT=3100
E2E_DATABASE_URL=postgres://daisy_e2e:e2e-loopback-only@localhost:15432/daisy_test
E2E_REDIS_URL=redis://localhost:6379/2
E2E_REDIS_NAMESPACE=daisy-e2e
# Explicitly enable the development-only architectural proof page/API.
FOUNDATION_PROOF_ENABLED=false
# PageSpace incoming webhooks for the existing Daisy Debate drive.
# Channel notifications are signed POSTs; CI reads these from Actions secrets.
PAGESPACE_STANDUP_WEBHOOK_URL=
PAGESPACE_STANDUP_WEBHOOK_SECRET=
PAGESPACE_INCIDENTS_WEBHOOK_URL=
PAGESPACE_INCIDENTS_WEBHOOK_SECRET=
PAGESPACE_SPRINT_ROOM_WEBHOOK_URL=
PAGESPACE_SPRINT_ROOM_WEBHOOK_SECRET=
PAGESPACE_EPIC_UPDATES_WEBHOOK_URL=
PAGESPACE_EPIC_UPDATES_WEBHOOK_SECRET=
# Stable PageSpace documentation location. These IDs are not secrets.
PAGESPACE_DOCUMENTATION_DRIVE_ID=lguvh1y1ejhadk96xcftohha
PAGESPACE_DOCUMENTATION_ROOT_PAGE_ID=lt50h2qea588dpkmmcqgt5ct
PAGESPACE_DOCUMENTATION_AGENT_PAGE_ID=pvrgxyzjmnhzb303pihcaf7z
# Drive-scoped key `bun docs:dispatch` uses to consult the Documentation Agent.
# Keep the value in .env or an Actions secret, never in Git.
PAGESPACE_TOKEN=
# --- Authentication (email magic links and passkeys) -------------------------
# BETTER_AUTH_SECRET: 64-character random value. Run `bun auth:provision` to
# generate one into .env when missing; existing values are preserved. Never
# commit a real value.
# BETTER_AUTH_SECRET=<64-character random value>
# RESEND_API_KEY and AUTH_EMAIL_FROM need owner-provisioned Resend access and a
# verified sender domain (human prerequisite; see the authentication spec).
# RESEND_API_KEY=<re_… key from the Resend dashboard>
# AUTH_EMAIL_FROM=Daisy <no-reply@example.com>
# RESEND_WEBHOOK_SECRET: Svix signing secret (whsec_…) of the Resend webhook that
# targets /api/webhooks/resend. Required in production; never commit a real value.
# RESEND_WEBHOOK_SECRET=<whsec_… secret from the Resend webhook>
# Production client identity comes from the ingress (start.ts), which stamps
# x-daisy-client-ip on every request from the socket peer, replacing any caller
# value. Behind a reverse proxy set AUTH_TRUSTED_PROXIES: the X-Forwarded-For
# chain is then walked right to left past those hops. If your proxy is not
# listed, every user shares the proxy's address and one rate-limit bucket.
# AUTH_TRUSTED_IP_HEADERS: comma-separated header names consulted ONLY when no
# stamped identity exists (non-stamping runtimes such as `next dev`); it has no
# effect in production. Set only a header your own proxy overwrites, since any
# other is client-writable. Unset (the default) believes no header.
# AUTH_TRUSTED_IP_HEADERS=x-real-ip
# AUTH_TRUSTED_PROXIES: comma-separated IPs or CIDR ranges of your own proxies.
# Entries are validated more strictly than Better Auth does, and anything else
# fails configuration:
# plain IPv4/IPv6 addresses or CIDR ranges only, no leading-zero prefix (/08),
# and no IPv4-mapped IPv6 (::ffff:10.0.0.0/104). Write the IPv4 form instead.
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
