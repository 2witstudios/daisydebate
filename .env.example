NODE_ENV=development
# Host port 15432 maps to the compose Postgres; see infra/compose.yaml.
DATABASE_URL=postgres://daisy:local-development-only@localhost:15432/daisy
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=daisy
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
APP_VERSION=development
GIT_COMMIT=unknown
TEST_DATABASE_URL=postgres://daisy:local-development-only@localhost:15432/daisy_test
TEST_REDIS_URL=redis://localhost:6379/1
# Explicitly enable the development-only architectural proof page/API.
FOUNDATION_PROOF_ENABLED=false
# --- Parallel local sessions (optional) -------------------------------------
# A second checkout (git worktree, `pu` slot) can run its own isolated Compose
# stack: give it a distinct DAISY_STACK_NAME plus its own host ports, then
# point the URLs above at those ports. A distinct stack name gets its own
# containers and volumes, so sessions share no services and no data. E2E_PORT
# pins the browser suite away from the default (and disables server reuse, so
# a session can never silently test another session's server). Leave all of
# these unset for the default single-stack setup.
# DAISY_STACK_NAME=daisy-slot2
# DAISY_PG_PORT=25432
# DAISY_REDIS_PORT=26379
# PORT=3001
# E2E_PORT=13100
# E2E_REDIS_PORT=26379
# E2E_POSTGRES_PORT=25432
# PageSpace incoming webhooks (signed POSTs into drive channels); set locally
# only if testing scripts/notify-drive.ts — CI reads these from Actions secrets.
PAGESPACE_INCIDENTS_WEBHOOK_URL=
PAGESPACE_INCIDENTS_WEBHOOK_SECRET=
PAGESPACE_SPRINT_ROOM_WEBHOOK_URL=
PAGESPACE_SPRINT_ROOM_WEBHOOK_SECRET=
PAGESPACE_EPIC_UPDATES_WEBHOOK_URL=
PAGESPACE_EPIC_UPDATES_WEBHOOK_SECRET=
