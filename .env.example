NODE_ENV=development
# Host port 15432 maps to the compose Postgres; see infra/compose.yaml.
DATABASE_URL=postgres://daisy:local-development-only@localhost:15432/daisy
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=daisy
PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
APP_VERSION=development
GIT_COMMIT=unknown
TEST_DATABASE_URL=postgres://daisy:local-development-only@localhost:15432/daisy_test
TEST_REDIS_URL=redis://localhost:6379/1
# Explicitly enable the development-only architectural proof page/API.
FOUNDATION_PROOF_ENABLED=false
# --- Parallel local sessions (optional) -------------------------------------
# A second checkout (git worktree, `pu` slot) can run its own isolated Compose
# stack: give it a distinct DAISY_STACK_NAME plus its own host ports, then
# point the URLs above at those ports. A distinct stack name gets its own
# containers and volumes, so sessions share no services and no data. E2E_PORT
# pins the browser suite away from the default (and disables server reuse, so
# a session can never silently test another session's server). Leave all of
# these unset for the default single-stack setup.
# DAISY_STACK_NAME=daisy-slot2
# DAISY_PG_PORT=25432
# DAISY_REDIS_PORT=26379
# PORT=3001
# E2E_PORT=13100
# E2E_REDIS_PORT=26379
# E2E_POSTGRES_PORT=25432
# PageSpace incoming webhooks for the existing Daisy Debate drive.
# Channel notifications are signed POSTs; CI reads these from Actions secrets.
PAGESPACE_STANDUP_WEBHOOK_URL=
PAGESPACE_STANDUP_WEBHOOK_SECRET=
PAGESPACE_INCIDENTS_WEBHOOK_URL=
PAGESPACE_INCIDENTS_WEBHOOK_SECRET=
PAGESPACE_SPRINT_ROOM_WEBHOOK_URL=
PAGESPACE_SPRINT_ROOM_WEBHOOK_SECRET=
PAGESPACE_EPIC_UPDATES_WEBHOOK_URL=
PAGESPACE_EPIC_UPDATES_WEBHOOK_SECRET=
# Stable PageSpace documentation location. These IDs are not secrets.
PAGESPACE_DOCUMENTATION_DRIVE_ID=lguvh1y1ejhadk96xcftohha
PAGESPACE_DOCUMENTATION_ROOT_PAGE_ID=lt50h2qea588dpkmmcqgt5ct
PAGESPACE_DOCUMENTATION_AGENT_PAGE_ID=pvrgxyzjmnhzb303pihcaf7z
# One stable webhook to the Documentation Agent; new Canvas pages do not need
# individual webhooks.
PAGESPACE_DOCUMENTATION_AGENT_WEBHOOK_URL=
PAGESPACE_DOCUMENTATION_AGENT_WEBHOOK_SECRET=
# A drive-scoped key is required by the CLI/SDK when CI or a local script edits
# documentation. No repository code reads this variable: the `pagespace` CLI
# reads PAGESPACE_TOKEN from the environment itself (after --token, before the
# active `pagespace keys use` key). Leave it empty to use the active key. Keep
# the value in .env or an Actions secret, never in Git.
PAGESPACE_TOKEN=
# --- Authentication (email magic links and passkeys) -------------------------
# BETTER_AUTH_SECRET: 64-character random value. Run `bun auth:provision` to
# generate one into .env when missing; existing values are preserved. Never
# commit a real value.
# BETTER_AUTH_SECRET=<64-character random value>
# RESEND_API_KEY and AUTH_EMAIL_FROM need owner-provisioned Resend access and a
# verified sender domain (human prerequisite; see the authentication spec).
# RESEND_API_KEY=<re_… key from the Resend dashboard>
# AUTH_EMAIL_FROM=Daisy <no-reply@example.com>
# RESEND_WEBHOOK_SECRET: Svix signing secret (whsec_…) of the Resend webhook that
# targets /api/webhooks/resend. Required in production; never commit a real value.
# RESEND_WEBHOOK_SECRET=<whsec_… secret from the Resend webhook>
# AUTH_TRUSTED_PROXIES: comma-separated IP/CIDR list of deployment ingress hops
# whose X-Forwarded-For is honored for rate limiting. Leave unset when the app is
# reached directly: then only the socket peer identifies a client. See
# docs/operations/auth-delivery.md.
# AUTH_TRUSTED_PROXIES=10.0.0.0/8
