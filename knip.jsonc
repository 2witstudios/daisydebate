{
  // Dead-code gate: unused files, exports and dependencies fail the run.
  // Run with `bun run knip` (under Bun, per the toolchain contract).
  "$schema": "./node_modules/knip/schema.json",
  // Scenario documents are loaded by the `bun scenario <name>` CLI.
  "ignore": ["scenarios/*.ts"],
  "includeEntryExports": true,
  // Their binaries run behind the heavy queue (`bun scripts/heavy.ts turbo
  // …`, `… sh -c 'bunx --bun jscpd …'`), where knip does not look.
  "ignoreDependencies": ["turbo", "jscpd"],
  "workspaces": {
    // Heavy scripts run through `bun scripts/heavy.ts <command…>`, and knip
    // reads only the queue as their entry; these are the commands behind it.
    ".": {
      "entry": [
        "scripts/**/*.test.ts",
        "eslint.config.test.ts",
        "scripts/check-boundaries.ts",
        "scripts/check-styling.ts",
        "scripts/check-affected.ts",
        "scripts/dev-agent.ts",
        "scripts/verify.ts",
        "scripts/prove-round-judging.ts",
      ],
    },
    // The e2e production server is started by Playwright's webServer command.
    // Integration suites are globbed by scripts/test-integration.ts, which
    // each workspace's test:integration runs instead of listing files.
    "apps/web": {
      "entry": [
        // `test` runs `bun test src scripts` through the heavy queue.
        "src/**/*.test.{ts,tsx}",
        "scripts/**/*.test.ts",
        "e2e/support/server.ts",
        "e2e/support/realtime-config.ts",
        "e2e/support/realtime-runner.ts",
        "e2e/support/messaging-realtime-config.ts",
        "e2e/support/messaging-data-worker.ts",
        // Launch config/server are process entries selected by runner/command replacement;
        // evidence/release are Bun subprocess CLI entries, never browser imports.
        "e2e/support/room-launch-config.ts",
        "e2e/support/room-launch-server.ts",
        "e2e/support/room-launch-evidence-process.ts",
        "e2e/support/room-launch-release.ts",
        // Spawned by the native ballot fixture under Bun, never imported by the Node driver.
        "e2e/support/human-ballot-maintenance-process.ts",
        "integration/**/*.integration.ts",
        // AUTH-6.7 load harness: run.ts and abuse-run.ts are CLI entries;
        // instance-process.ts is spawned as a subprocess, never imported.
        "scripts/auth-load/run.ts",
        "scripts/auth-load/abuse-run.ts",
        "scripts/auth-load/instance-process.ts",
      ],
    },
    "packages/db": { "entry": ["integration/**/*.integration.ts"] },
    "packages/media": { "entry": ["integration/**/*.integration.ts"] },
    "apps/realtime": {
      "entry": [
        "integration/**/*.integration.ts",
        "integration/browser-server.ts",
      ],
    },
    "packages/redis": {
      "entry": ["integration/**/*.integration.ts"],
    },
  },
}
