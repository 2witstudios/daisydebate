{
  // Dead-code gate: unused files, exports and dependencies fail the run.
  // Run with `bun run knip` (under Bun, per the toolchain contract).
  "$schema": "./node_modules/knip/schema.json",
  "ignore": [
    // Loaded as a Knip config by knip:production through the heavy queue.
    "knip.production.ts",
    // Scenario documents are loaded by the `bun scenario <name>` CLI.
    "scenarios/*.ts",
    // Read as text by judge-bench/remote.ts and run on a deployed web
    // machine, against that machine's own dependencies.
    "scripts/judge-bench/remote-read.ts",
    // Compiled by scripts/native-sdk-declarations.test.ts as CommonJS and as
    // an ES module; nothing imports them.
    "packages/media/integration/native-track-stats-public.test-support.{cts,mts}",
    // The drills' Playwright configs: Playwright reads each default export by
    // `--config`, and loading one outside its Launch slot throws, so the
    // Playwright plugin cannot be given them.
    "apps/web/e2e/support/{node-kill-drill,first-word,bot-freestyle}-config.ts",
  ],
  "includeEntryExports": true,
  // Their binaries run behind the heavy queue (`bun scripts/heavy.ts turbo
  // …`, `… sh -c 'bunx --bun jscpd …'`), where knip does not look.
  "ignoreDependencies": ["turbo", "jscpd"],
  "workspaces": {
    // Heavy scripts run through `bun scripts/heavy.ts <command…>`, and knip
    // reads only the queue as their entry; these are the commands behind it.
    ".": {
      "entry": [
        "scripts/**/*.test.ts",
        "eslint.config.test.ts",
        "scripts/check-boundaries.ts",
        "scripts/check-styling.ts",
        "scripts/check-affected.ts",
        "scripts/dev-agent.ts",
        "scripts/verify.ts",
        "scripts/prove-round-judging.ts",
        "scripts/prove-media-worker.ts",
        // Bundled by the staging-only manual workflow and piped to Fly stdin.
        "scripts/staging-transcript-proof.ts",
      ],
    },
    // The e2e production server is started by Playwright's webServer command.
    // Integration suites are globbed by scripts/test-integration.ts, which
    // each workspace's test:integration runs instead of listing files.
    "apps/web": {
      // macOS speech for the on-demand drills' human speaker.
      "ignoreBinaries": ["say"],
      // Spawned from the workspace root by browser-capture.e2e.ts; an entry below.
      "ignoreUnresolved": ["e2e/support/server.ts"],
      "playwright": {
        "config": ["playwright.config.ts", "playwright.analytics.config.ts"],
      },
      "entry": [
        // `test` runs `bun test src scripts` through the heavy queue.
        "src/**/*.test.{ts,tsx}",
        "scripts/**/*.test.ts",
        // Manual SDK/repair CLIs; the browser proof module is bundled by Bun.
        "scripts/prove-sentry-browser.ts",
        "scripts/staging-attendance-probe.ts",
        "src/features/telemetry/sentry-browser.test-support.ts",
        // Spawned by isolated messaging caller tests; paths belong to this workspace.
        "scripts/messaging-navigation-realm.test-support.ts",
        "scripts/messaging-reaction-realm.test-support.ts",
        "scripts/shell-navigation-realm.test-support.ts",
        // Writes the Recording gap slate the recording worker ships as an asset.
        "scripts/gap-slate.ts",
        "e2e/support/server.ts",
        // Bundled by the media-stage browser proof via the Bun CLI.
        "e2e/support/media-stage-fixture.tsx",
        // Explicit Bun workers for isolated ranked setup/rendering evidence.
        "e2e/support/rating-season-worker.ts",
        "e2e/support/rating-display-worker.ts",
        "integration/rating-recovery-worker.test-support.ts",
        "e2e/support/realtime-config.ts",
        "e2e/support/realtime-runner.ts",
        "e2e/support/messaging-realtime-config.ts",
        "e2e/support/messaging-data-worker.ts",
        "e2e/support/transcript-seed-process.ts",
        "e2e/support/broadcast-seed-process.ts",
        "e2e/support/league-request-process.ts",
        "e2e/support/hosting-seed-process.ts",
        "e2e/support/tab-oracle-data.ts",
        // Started by messaging-realtime-config.ts's webServer command.
        "e2e/support/messaging-media-edge.ts",
        // The on-demand drills (`bun drill:first-word`, `bun drill:bot-freestyle`)
        // and the floor driver (`bun floor:local`, `bun floor:driver`): each
        // runner spawns its queued entry, which names its config.
        "e2e/support/first-word-queued.ts",
        "e2e/support/first-word-config.ts",
        "e2e/support/bot-freestyle-queued.ts",
        "e2e/support/bot-freestyle-config.ts",
        "e2e/support/floor-local-stack.ts",
        "e2e/support/floor-control-browser.ts",
        // Launch config/server are process entries selected by runner/command replacement;
        // evidence/release are Bun subprocess CLI entries, never browser imports.
        "e2e/support/room-launch-config.ts",
        "e2e/support/room-launch-server.ts",
        // Explicit subprocess/container entries, with no browser import edge.
        "e2e/support/room-launch-app.ts",
        "e2e/support/room-launch-queued.ts",
        // The on-demand node kill drill: never in CI, started by its runner.
        "e2e/node-kill-drill.e2e.ts",
        "e2e/support/node-kill-drill-runner.ts",
        "e2e/support/node-kill-drill-queued.ts",
        "e2e/support/node-kill-drill-config.ts",
        "e2e/support/node-kill-drill-evidence-process.ts",
        "e2e/support/launch-browser-network.mjs",
        // CI executes these proof CLIs through the heavy queue; the Node driver is spawned.
        "e2e/support/launch-browser-archive-proof.ts",
        "e2e/support/launch-browser-image-proof.ts",
        "e2e/support/launch-browser-image-proof.mjs",
        "e2e/support/launch-browser-preparation-proof.ts",
        "e2e/support/room-launch-evidence-process.ts",
        "e2e/support/attendance-evidence-process.ts",
        "e2e/support/bot-speech-evidence-process.ts",
        "e2e/support/realtime-private-room-process.ts",
        "e2e/support/room-launch-release.ts",
        // Spawned by the native ballot fixture under Bun, never imported by the Node driver.
        "e2e/support/human-ballot-maintenance-process.ts",
        "e2e/support/analysis-fixture-process.ts",
        "integration/**/*.integration.ts",
        // Spawned by audio-publication-room-ended.integration.ts, so native
        // state never lives in the shared runner (ISSUE-789).
        "integration/audio-publication-room-ended-process.ts",
        // AUTH-6.7 load harness: run.ts and abuse-run.ts are CLI entries;
        // instance-process.ts is spawned as a subprocess, never imported.
        "scripts/auth-load/run.ts",
        "scripts/auth-load/abuse-run.ts",
        "scripts/auth-load/instance-process.ts",
      ],
    },
    "packages/db": {
      "entry": [
        "integration/**/*.integration.ts",
        "scripts/rating-preflight.ts",
        "scripts/bench-row-parsing.ts",
        "scripts/sweeps/tx.ts",
        "scripts/sweeps/locks.ts",
        "scripts/sweeps/run.ts",
        // Prints a new tenant table's policies (docs/operations/database.md).
        "scripts/tenant-policies.ts",
      ],
    },
    // ADR 0077: the custom server and the two CLIs are process entries
    // (`start`, fly.admin-migrate.toml's release command, `fly ssh console`).
    "apps/admin": {
      // External system OpenSSL generates the declared HTTPS fixture's test certificate.
      "ignoreBinaries": ["openssl"],
      "entry": [
        "src/server/start.ts",
        "src/db/migrate.ts",
        "src/scripts/operator-enroll.ts",
        // Playwright launches this TLS proxy through webServer.command.
        "e2e/support/https-proxy.ts",
        "e2e/support/prepare.ts",
        "e2e/support/operator-api-server.ts",
        "integration/**/*.integration.ts",
      ],
    },
    "packages/media": {
      "entry": [
        "integration/**/*.integration.ts",
        // The pacing observation CLIs (docs/development/media-pacing.md).
        "integration/observe-pacing.ts",
        "integration/analyze-pacing.ts",
      ],
    },
    "apps/log-shipper": {
      "entry": ["src/start.ts", "integration/**/*.integration.ts"],
    },
    "apps/recording-worker": {
      "entry": ["src/start.ts", "integration/**/*.integration.ts"],
    },
    "apps/audience-publisher": {
      "entry": ["src/start.ts"],
    },
    "apps/media-worker": {
      // Bun.resolveSync selects the isolated native subprocess entries; the
      // room-launch composition spawns the e2e worker by path.
      "entry": [
        "src/capture-process.ts",
        "src/**/*.test.ts",
        "e2e/launch-worker.ts",
        "e2e/launch-capture.ts",
        "integration/**/*.integration.ts",
        "integration/frame-capture-entry.ts",
        // Spawned by apps/web's necessary-evidence-signed integration suite.
        "src/original-frame-carry.process.test-support.ts",
      ],
    },
    "apps/realtime": {
      "entry": [
        "integration/**/*.integration.ts",
        "integration/browser-server.ts",
      ],
    },
    "packages/redis": {
      "entry": ["integration/**/*.integration.ts"],
    },
  },
}
