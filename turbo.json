{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": [
    "packages/typescript-config/*.json",
    "eslint.config.mjs",
    ".prettierrc.json",
    "fly*.toml",
    "policy/**",
    "scripts/**",
    "infra/**",
    ".github/**",
    "spec/**",
    "tsconfig.json",
    "bunfig.toml",
    ".env*",
    ".bun-version"
  ],
  "globalEnv": ["NODE_ENV"],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "TEST_ADMIN_DATABASE_URL",
    "E2E_ADMIN_DATABASE_URL",
    "REDIS_URL",
    "TEST_REDIS_URL",
    "REDIS_NAMESPACE",
    "PUBLIC_APP_URL",
    "LOG_LEVEL",
    "FOUNDATION_PROOF_ENABLED",
    "NEXT_MANUAL_SIG_HANDLE",
    "PORT",
    "LISTEN_HOST",
    "REALTIME_PORT",
    "REALTIME_HOST",
    "E2E_PORT",
    "E2E_DATABASE_URL",
    "E2E_REDIS_URL",
    "E2E_REDIS_NAMESPACE",
    "PW_WS_ENDPOINT",
    "DAISY_HEAVY_CONCURRENCY",
    "DAISY_HEAVY_LOCK_DIR",
    "DAISY_HEAVY_POLL_MS",
    "DAISY_HEAVY_TIMEOUT_MINUTES"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "BETTER_AUTH_SECRET",
        "RECIPIENT_HASH_SECRET",
        "RESEND_API_KEY",
        "AUTH_EMAIL_FROM",
        "RESEND_WEBHOOK_SECRET",
        "AUTH_TRUSTED_PROXIES",
        "OPS_PROBE_TOKEN"
      ]
    },
    "build": {
      "env": ["APP_VERSION", "GIT_COMMIT"],
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test:integration": {
      "cache": false,
      "passThroughEnv": ["CLAMD_TEST_PORT"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "check": {
      "dependsOn": ["typecheck", "lint", "test", "build"]
    }
  },
  "cacheDir": ".turbo/cache"
}
