{
  "name": "@daisy/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./slots": "./src/slots.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "test:integration": "bun ../../scripts/test-integration.ts",
    "db:generate": "bun --bun x drizzle-kit generate",
    "db:migrate": "bun scripts/migrate.ts",
    "db:studio": "bun --bun x drizzle-kit studio"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@daisy/protocol": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "drizzle-orm": "0.45.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "riteway": "9.3.0"
  }
}
