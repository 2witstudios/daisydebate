{
  "name": "@daisy/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "test": "bun test src",
    "test:integration": "bun ../../scripts/test-integration.ts",
    "dev": "bun --watch src/start.ts",
    "start": "NODE_ENV=production bun src/start.ts"
  },
  "dependencies": {
    "@daisy/auth": "workspace:*",
    "@daisy/clock": "workspace:*",
    "@daisy/config": "workspace:*",
    "@daisy/db": "workspace:*",
    "@daisy/errors": "workspace:*",
    "@daisy/ingress": "workspace:*",
    "@daisy/logger": "workspace:*",
    "@daisy/observability": "workspace:*",
    "@daisy/protocol": "workspace:*",
    "@daisy/redis": "workspace:*",
    "@sentry/bun": "11.10.0"
  },
  "devDependencies": {
    "riteway": "9.3.0"
  }
}
