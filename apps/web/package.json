{
  "name": "@daisy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --bun next dev",
    "build": "NODE_ENV=production bun --bun next build",
    "start": "NODE_ENV=production bun src/server/start.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test src scripts",
    "test:integration": "bun ../../scripts/test-integration.ts",
    "test:e2e": "bun ../../scripts/e2e-limit.ts node node_modules/@playwright/test/cli.js test",
    "load:local": "bun --env-file=../../.env run scripts/auth-load/run.ts",
    "load:abuse": "bun --env-file=../../.env run scripts/auth-load/abuse-run.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.5",
    "@daisy/ai-voice": "workspace:*",
    "@daisy/auth": "workspace:*",
    "@daisy/clock": "workspace:*",
    "@daisy/config": "workspace:*",
    "@daisy/db": "workspace:*",
    "@daisy/debate-engine": "workspace:*",
    "@daisy/errors": "workspace:*",
    "@daisy/logger": "workspace:*",
    "@daisy/observability": "workspace:*",
    "@daisy/protocol": "workspace:*",
    "@daisy/redis": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "@tiptap/core": "3.31.4",
    "@tiptap/extension-list": "3.31.4",
    "@tiptap/extensions": "3.31.4",
    "@tiptap/html": "3.31.4",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "better-auth": "1.7.5",
    "happy-dom": "20.14.5",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/memory-adapter": "1.7.5",
    "@playwright/test": "1.63.0",
    "@simplewebauthn/server": "13.3.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.63.0",
    "postcss": "8.5.28",
    "riteway": "9.3.0",
    "tailwindcss": "4.3.3"
  }
}
