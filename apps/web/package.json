{
  "name": "@daisy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --env-file=../../.env --bun next dev",
    "build": "NODE_ENV=production bun --bun next build",
    "start": "NODE_ENV=production bun src/server/start.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test src",
    "test:integration": "bun test ./integration/foundation.integration.ts ./integration/auth-database.integration.ts ./integration/auth-passkey.integration.ts ./integration/auth-database-failures.integration.ts ./integration/auth-magic-link.integration.ts ./integration/auth-link-safety.integration.ts ./integration/auth-failure.integration.ts ./integration/auth-rate-limit.integration.ts ./integration/auth-ingress.integration.ts ./integration/auth-mail-events.integration.ts ./integration/auth-mail-suppression.integration.ts ./integration/auth-cookie-neutrality.integration.ts ./integration/auth-sign-in-journey.integration.ts ./integration/auth-username-claim.integration.ts ./integration/webauthn-authenticator.smoke.integration.ts ./integration/auth-passkey-ceremony.integration.ts ./integration/auth-passkey-management.integration.ts ./integration/auth-session-management.integration.ts ./integration/auth-email-change.integration.ts ./integration/auth-migration-restart.integration.ts",
    "test:e2e": "node node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.5",
    "@daisy/auth": "workspace:*",
    "@daisy/clock": "workspace:*",
    "@daisy/config": "workspace:*",
    "@daisy/db": "workspace:*",
    "@daisy/debate-engine": "workspace:*",
    "@daisy/errors": "workspace:*",
    "@daisy/logger": "workspace:*",
    "@daisy/observability": "workspace:*",
    "@daisy/protocol": "workspace:*",
    "@daisy/redis": "workspace:*",
    "@paralleldrive/cuid2": "3.3.0",
    "better-auth": "1.7.5",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/memory-adapter": "1.7.5",
    "@playwright/test": "1.63.0",
    "@simplewebauthn/server": "13.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "postcss": "8.5.28",
    "riteway": "9.3.0",
    "tailwindcss": "4.3.3"
  }
}
