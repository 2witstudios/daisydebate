#!/bin/sh
# Daisy pre-push hook. Opt in once per clone with: bun hooks:install
# (sets core.hooksPath to .githooks). Runs the fast affected-graph gate so a
# push cannot skip verification by accident. `bun check` remains the full gate
# and CI is the enforcement of record; bypass deliberately with --no-verify.
set -eu

# Deleting a remote branch pushes no commits; there is nothing to verify.
pushes_commits=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) pushes_commits=1 ;;
  esac
done
[ "$pushes_commits" -eq 1 ] || exit 0

cd "$(git rev-parse --show-toplevel)"
# git feeds ref data on stdin; keep it away from the check's child processes.
exec bun check:affected </dev/null
